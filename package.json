{
  "name": "businessvault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:tide": "node --test tests/tide/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:vault": "vitest run tests/vault",
    "test:e2e": "playwright test",
    "vault:leak-scan": "node --experimental-strip-types scripts/vault/leak-scan.ts",
    "test:governance": "node --test tests/governance/*.mjs",
    "doctor": "node scripts/dev/doctor.mjs",
    "test:all": "vitest run",
    "test:it": "node scripts/dev/run-it.mjs",
    "seed:demo": "node scripts/dev/seed-demo.mjs",
    "dev:sim": "node scripts/dev/dev-sim.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-presigned-post": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@prisma/client": "6.19.0",
    "@tidecloak/nextjs": "^0.14.40",
    "@tidecloak/verify": "^0.14.33",
    "next": "16.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "prisma": "6.19.0",
    "typescript": "5.8.3",
    "vitest": "5.0.5"
  }
}
