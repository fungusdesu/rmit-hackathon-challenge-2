FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
ARG NEXT_PUBLIC_AUTH_MODE=development
ARG NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL
ARG NEXT_PUBLIC_TIDECLOAK_REALM
ARG NEXT_PUBLIC_TIDECLOAK_CLIENT_ID
ARG NEXT_PUBLIC_TIDECLOAK_REDIRECT_URI
ARG NEXT_PUBLIC_TIDECLOAK_ADAPTER_JSON
ENV NEXT_PUBLIC_AUTH_MODE=$NEXT_PUBLIC_AUTH_MODE
ENV NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL=$NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL
ENV NEXT_PUBLIC_TIDECLOAK_REALM=$NEXT_PUBLIC_TIDECLOAK_REALM
ENV NEXT_PUBLIC_TIDECLOAK_CLIENT_ID=$NEXT_PUBLIC_TIDECLOAK_CLIENT_ID
ENV NEXT_PUBLIC_TIDECLOAK_REDIRECT_URI=$NEXT_PUBLIC_TIDECLOAK_REDIRECT_URI
ENV NEXT_PUBLIC_TIDECLOAK_ADAPTER_JSON=$NEXT_PUBLIC_TIDECLOAK_ADAPTER_JSON
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
