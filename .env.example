DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Optional: absolute Linux filesystem path if Docker volumes are on a Windows drive.
# POSTGRES_DATA_DIR=<absolute-linux-filesystem-path>
AUTH_MODE=<tidecloak-or-development>
NEXT_PUBLIC_AUTH_MODE=<tidecloak-or-development>
TIDECLOAK_AUTH_SERVER_URL=<tidecloak-server-url>
TIDECLOAK_REALM=<realm-name>
TIDECLOAK_CLIENT_ID=<client-id>
NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL=<browser-accessible-tidecloak-url>
NEXT_PUBLIC_TIDECLOAK_REALM=<realm-name>
NEXT_PUBLIC_TIDECLOAK_CLIENT_ID=<client-id>
NEXT_PUBLIC_TIDECLOAK_REDIRECT_URI=<application-callback-url>
# Development only: set AUTH_MODE=development for local API testing.
# ALLOW_INSECURE_DEV_AUTH=<true-for-local-development-only>
# DEV_AUTH_SUBJECT=<development-user-subject>
# DEV_AUTH_NAME=<development-user-name>
# DEV_AUTH_EMAIL=<development-user-email>
S3_ENDPOINT=<object-storage-endpoint>
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
