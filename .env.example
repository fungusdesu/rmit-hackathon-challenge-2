DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
APP_ORIGIN=http://localhost:3000
# Optional: absolute Linux filesystem path if Docker volumes are on a Windows drive.
# POSTGRES_DATA_DIR=/home/your-user/.local/share/businessvault/postgres
AUTH_MODE=tidecloak
NEXT_PUBLIC_AUTH_MODE=tidecloak
TIDECLOAK_AUTH_SERVER_URL=http://localhost:8080
TIDECLOAK_REALM=nextjs-test
TIDECLOAK_CLIENT_ID=myclient
NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_TIDECLOAK_REALM=nextjs-test
NEXT_PUBLIC_TIDECLOAK_CLIENT_ID=myclient
NEXT_PUBLIC_TIDECLOAK_REDIRECT_URI=http://localhost:3000/auth/redirect
# Optional full adapter JSON generated by TideCloak. Required for native Tide operations such as E2EE.
# TIDECLOAK_ADAPTER_JSON=
# NEXT_PUBLIC_TIDECLOAK_ADAPTER_JSON=
# Development only: set AUTH_MODE=development for local API testing.
# ALLOW_INSECURE_DEV_AUTH=true
# DEV_AUTH_SUBJECT=local-owner
# DEV_AUTH_NAME=Local Owner
# DEV_AUTH_EMAIL=owner@localhost.test
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=businessvault
S3_ACCESS_KEY_ID=businessvault
S3_SECRET_ACCESS_KEY=businessvault-secret
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
VAULT_MAX_CIPHERTEXT_BYTES=5242880
